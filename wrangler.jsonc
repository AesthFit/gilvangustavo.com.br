{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gilvangustavo",
  "main": "./.output/server/index.mjs",
  "account_id": "de66398e0fd4bf1873f26815de955ddc",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "gilvangustavo.com.br", "custom_domain": true },
    { "pattern": "www.gilvangustavo.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  }
}
